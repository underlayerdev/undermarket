{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist/undermarket/browser",
    "i18n": {
      "root": "/"
    },
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
