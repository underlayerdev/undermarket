rules_version = '2';

// Keep these in sync with src/app/domain/listing/listing-constraints.ts,
// src/app/domain/category-node/category-node.model.ts,
// src/app/domain/condition/condition.model.ts,
// src/app/domain/currency/currency.model.ts,
// src/app/domain/location/location.model.ts,
// src/app/domain/user/user-constraints.ts, and
// functions/src/users/username.ts (handle format, enforced by the
// claimUsername callable rather than here — see `usernames` below).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidCondition(condition) {
      return condition in ['New', 'Used'];
    }

    // A leaf id in the `categories/{categoryId}` tree, plus its root->leaf
    // ancestor path ending with that same id — mirrors the shape check in
    // validateNewListing (listing.validator.ts). Doesn't check the id
    // actually exists/is a leaf in the categories collection — that tree is
    // populated by an offline seed script, not something a security rule can
    // cheaply cross-reference per write.
    function isValidCategoryRef(categoryId, categoryPath) {
      return categoryId is string && categoryId.size() > 0
        && categoryPath is list && categoryPath.size() > 0
        && categoryPath[categoryPath.size() - 1] == categoryId;
    }

    // Max price is per-currency (ARS runs much higher than USD due to
    // inflation) — mirrors CURRENCIES in currency.model.ts.
    function maxPriceForCurrency(currency) {
      return currency == 'ARS' ? 1000000000 : 1000000;
    }

    function isValidPrice(price, currency) {
      return currency in ['ARS', 'USD']
        && price is number && price >= 0 && price <= maxPriceForCurrency(currency);
    }

    // Area-level only (city/neighborhood/region + coordinates) — never an
    // exact address. `geohash` is duplicated at the top level of the listing
    // doc so Firestore can range-query it; the two must always agree.
    function isValidLocation(location) {
      return location.keys().hasAll(['displayName', 'countryCode', 'region', 'city', 'latitude', 'longitude', 'geohash'])
        && location.displayName is string && location.displayName.size() > 0 && location.displayName.size() <= 120
        && location.countryCode is string
        && location.region is string
        && location.city is string && location.city.size() > 0
        && location.latitude is number && location.latitude >= -90 && location.latitude <= 90
        && location.longitude is number && location.longitude >= -180 && location.longitude <= 180
        && location.geohash is string && location.geohash.size() > 0;
    }

    function isValidNewListing(data) {
      return data.keys().hasAll(
        ['ownerId', 'title', 'description', 'price', 'currency', 'categoryId', 'categoryPath', 'condition', 'status', 'imageUrls', 'createdAt', 'updatedAt', 'location', 'geohash']
      )
        && data.ownerId is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 2000
        && isValidPrice(data.price, data.currency)
        && isValidCategoryRef(data.categoryId, data.categoryPath)
        && isValidCondition(data.condition)
        && data.status == 'active'
        && data.imageUrls is list && data.imageUrls.size() == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidLocation(data.location)
        && data.geohash == data.location.geohash;
    }

    function isValidListingUpdate(data) {
      // location/geohash/condition/categoryId/categoryPath are validated when
      // present, but not required here — unlike a brand-new listing, an
      // update to a listing that predates one of these fields (e.g. a
      // status-only change) must not be blocked just because it has none.
      // New listings always get all of them going forward, per
      // isValidNewListing above.
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 2000
        && isValidPrice(data.price, data.currency)
        && (!data.keys().hasAny(['categoryId', 'categoryPath'])
          || (data.keys().hasAll(['categoryId', 'categoryPath'])
            && isValidCategoryRef(data.categoryId, data.categoryPath)))
        && (!data.keys().hasAny(['condition']) || isValidCondition(data.condition))
        && (data.status == 'active' || data.status == 'sold' || data.status == 'draft')
        && data.imageUrls is list
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['location'])
          || (isValidLocation(data.location) && data.geohash == data.location.geohash));
    }

    match /listings/{listingId} {
      // Anyone can browse published listings (public marketplace); a draft
      // (own or imported, not yet reviewed/published) is only readable by
      // its owner. Client-side query filters mirror this, but the rule is
      // the actual enforcement — a direct read/list bypassing the app must
      // still be blocked. Only the owner (a signed-in user) may
      // create/update/delete their own listings.
      allow read: if resource.data.status != 'draft'
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidNewListing(request.resource.data);

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && isValidListingUpdate(request.resource.data);

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Hierarchical category tree (see docs/categories-plan.md and
    // src/app/domain/category-node/category-node.model.ts) — browseable by
    // everyone, but written only by the offline seed script
    // (functions/src/categories/seed-categories.ts) via the Admin SDK, which
    // bypasses these rules entirely. No client writes here — listing
    // create/update above only ever reference a node by id/path
    // (isValidCategoryRef), never write to this collection.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // City/region/country only — no coordinates, unlike isValidLocation
    // above, since this is for display on a public profile, never a
    // distance query.
    function isValidProfileCity(profileCity) {
      return profileCity.keys().hasAll(['displayName', 'city', 'region', 'countryCode'])
        && profileCity.displayName is string && profileCity.displayName.size() > 0 && profileCity.displayName.size() <= 120
        && profileCity.city is string && profileCity.city.size() > 0
        && profileCity.region is string
        && profileCity.countryCode is string;
    }

    match /users/{userId} {
      // Display names/avatars are shown on listings, so profiles are
      // publicly readable. profileCity is opted-in and validated when
      // present — absent (not a hidden/false flag) is how "not shown" is
      // represented, so there's nothing city-shaped to leak from a direct
      // read either way.
      allow read: if true;
      // Created only by the onUserCreate Cloud Function (Admin SDK bypasses
      // rules) — see functions/src/users/on-create.ts. Clients never create
      // their own doc, mirroring mercadoLibreConnections' server-only
      // pattern below — this is what makes onboarding's `onboarded: false`
      // starting state trustworthy rather than just a UI convention.
      allow create: if false;
      // `onboarded` must come out of the write unchanged — clients (see
      // FirestoreUserRepository.update()) never include it, but this is the
      // actual enforcement, not just a client-side convention. Only the
      // onUserProfileUpdated Cloud Function (functions/src/users/on-update.ts,
      // Admin SDK) is allowed to flip it, once it observes a not-yet-onboarded
      // profile pick up a valid displayName.
      //
      // `displayName` is pinned too: its format (alphabets, look-alike
      // characters, links, reserved names) needs checks a rules expression
      // can't do — RE2 has no backreferences and rules can't normalize
      // Unicode — so the changeDisplayName callable
      // (functions/src/users/change-display-name.ts) is the only writer.
      // FirestoreUserRepository.update() leaves it out of its payload, so an
      // ordinary profile save never touches it. A not-yet-onboarded profile
      // keeps the '' onUserCreate seeded until that callable runs.
      //
      // `username`/`usernameChangedAt` are pinned the same way: a handle is
      // only unique because claimUsername (functions/src/users/claim-username.ts)
      // checks and writes it together with its `usernames` entry in one
      // transaction. A direct client write could take a handle someone else
      // holds without that check. `usernameChangedAt` is absent until the
      // user first picks a handle themselves, hence `.get(..., null)`; the
      // handle itself must always be there (onUserCreate assigns it).
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.onboarded == resource.data.onboarded
        && request.resource.data.username is string
        && request.resource.data.username == resource.data.get('username', null)
        && request.resource.data.get('usernameChangedAt', null) == resource.data.get('usernameChangedAt', null)
        && request.resource.data.get('displayName', null) == resource.data.get('displayName', null)
        && (!request.resource.data.keys().hasAny(['profileCity'])
          || request.resource.data.profileCity == null
          || isValidProfileCity(request.resource.data.profileCity));
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Handle → uid index that makes User.username unique: one doc per handle,
    // keyed by the handle, written only by Cloud Functions (onUserCreate,
    // claimUsername, onUserDeleted — Admin SDK). Publicly readable so a
    // /u/<handle> link can be resolved and the settings form can hint at
    // availability; it only exposes handle → uid, which users/{userId}
    // already makes public.
    match /usernames/{username} {
      allow read: if true;
      allow write: if false;
    }

    // The user's "where am I browsing right now" preference — kept out of
    // users/{userId} deliberately, since that doc is publicly readable
    // (above) and this reveals roughly where someone lives/spends time.
    match /userSearchLocations/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // MercadoLibre OAuth state (short-lived, keyed by the `state` param) and
    // per-user connection tokens. Both are written and read exclusively by
    // Cloud Functions via the Admin SDK, which bypasses these rules
    // entirely — denying all client access here is the actual security
    // boundary, not an oversight to relax later. Never move access/refresh
    // tokens into a client-readable document (e.g. `users/{userId}` is
    // publicly readable, per the rule above).
    match /mercadoLibreAuthSessions/{state} {
      allow read, write: if false;
    }

    match /mercadoLibreConnections/{userId} {
      allow read, write: if false;
    }

    // Cache of AI category-classification results for imported listings
    // (functions/src/categories/category-map.ts), keyed by "{provider}:{externalCategoryId}" —
    // Admin SDK / Cloud Functions only, same reasoning.
    match /categoryClassifications/{id} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
