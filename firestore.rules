rules_version = '2';

// Keep these in sync with src/app/domain/listing/listing-constraints.ts,
// src/app/domain/category/category.model.ts, and
// src/app/domain/currency/currency.model.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidCategory(category) {
      return category in [
        'Electronics', 'Clothing', 'Furniture', 'Vehicles', 'Books', 'Sports', 'Other'
      ];
    }

    // Max price is per-currency (ARS runs much higher than USD due to
    // inflation) — mirrors CURRENCIES in currency.model.ts.
    function maxPriceForCurrency(currency) {
      return currency == 'ARS' ? 1000000000 : 1000000;
    }

    function isValidPrice(price, currency) {
      return currency in ['ARS', 'USD']
        && price is number && price >= 0 && price <= maxPriceForCurrency(currency);
    }

    function isValidNewListing(data) {
      return data.keys().hasAll(
        ['ownerId', 'title', 'description', 'price', 'currency', 'category', 'status', 'imageUrls', 'createdAt', 'updatedAt']
      )
        && data.ownerId is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 2000
        && isValidPrice(data.price, data.currency)
        && isValidCategory(data.category)
        && data.status == 'active'
        && data.imageUrls is list && data.imageUrls.size() == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidListingUpdate(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 2000
        && isValidPrice(data.price, data.currency)
        && isValidCategory(data.category)
        && (data.status == 'active' || data.status == 'sold')
        && data.imageUrls is list
        && data.updatedAt is timestamp;
    }

    match /listings/{listingId} {
      // Anyone can browse listings (public marketplace); only the owner
      // (a signed-in user) may create/update/delete their own listings.
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidNewListing(request.resource.data);

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && isValidListingUpdate(request.resource.data);

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      // Display names/avatars are shown on listings, so profiles are
      // publicly readable; only the account owner can write their own doc.
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
